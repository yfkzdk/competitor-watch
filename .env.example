# 赛博监控 v2.0 — 环境变量配置
# 复制此文件为 .env 并修改。不要提交 .env 到版本控制。

# 应用
APP_NAME=竞品监控系统 API
APP_VERSION=2.0
DEBUG=false

# 数据库 (SQLite 文件路径)
DATABASE_PATH=competitor_watch.db

# 线程池最大工作线程数
MAX_WORKERS=10

# CORS 允许的来源 (逗号分隔，* 表示允许所有)
CORS_ORIGINS=*

# API 认证
# 留空则不启用 API Key 认证
API_KEY=
# 每 IP 每分钟请求限制
RATE_LIMIT_PER_MINUTE=60

# Demo 模式
# true = 启用模拟实时数据生成（无需外部依赖）
# false = 需要配置真实数据采集器
DEMO_MODE=true

# 通知配置路径
NOTIFICATION_CONFIG_PATH=config/notifications.json
